      "html": "<ul class=\"ds-tabs\"><li><a class=\"ds-tab\" href=\"#\" aria-current=\"true\"><span class=\"ds-tab__name\">Población</span><span class=\"ds-tab__value\">34.015</span></a></li><li><a class=\"ds-tab\" href=\"#\"><span class=\"ds-tab__name\">Economía</span><span class=\"ds-tab__value\">$1,28 bill.</span></a></li><li><a class=\"ds-tab\" href=\"#\"><span class=\"ds-tab__name\">Educación</span><span class=\"ds-tab__value\">86,9 %</span></a></li></ul>",
      "css": ".ds-tabs{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0.5rem;font-family:var(--nxgov-font,'Nunito Sans',sans-serif)} .ds-tab{display:flex;flex-direction:column;gap:0.125rem;padding:0.75rem 0.875rem;border:1px solid var(--nxgov-color-control,#6F7D99);border-radius:0.75rem 0.75rem 0 0;background:var(--nxgov-color-surface,#FFFFFF);color:var(--nxgov-color-ink,#0A1A3F);text-decoration:none;transition:background-color 180ms cubic-bezier(0.16,1,0.3,1),border-color 180ms cubic-bezier(0.16,1,0.3,1)} .ds-tab:hover{background:var(--nxgov-color-tint,#EAF0FB);border-color:var(--nxgov-color-cobalt,#0943B5)} .ds-tab:focus-visible{outline:3px solid var(--nxgov-color-cobalt,#0943B5);outline-offset:3px} .ds-tab__name{font-weight:700;font-size:0.9375rem} .ds-tab__value{font-family:var(--nxgov-font-display,'Work Sans',sans-serif);font-weight:700;font-size:1.375rem;line-height:1.15;color:var(--nxgov-color-cobalt,#0943B5);font-variant-numeric:tabular-nums} .ds-tab[aria-current=\"true\"]{background:var(--nxgov-color-ink,#0A1A3F);border-color:var(--nxgov-color-ink,#0A1A3F);color:var(--nxgov-color-surface,#FFFFFF)} .ds-tab[aria-current=\"true\"] .ds-tab__value{color:var(--nxgov-color-cut,#FDBF2D)}"
